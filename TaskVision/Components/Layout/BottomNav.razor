@inject NavigationManager NavManager

<div class="bottom-nav-container">
    <div class="bottom-nav-bar">
        @foreach (var item in navItems)
        {
            <button class="nav-btn @(IsActive(item.Url) ? "active" : "")"
                    @onclick="() => NavManager.NavigateTo(item.Url)">
                <i class="@item.IconClass"></i>
            </button>
        }
    </div>
</div>

@code {
    private List<(string Url, string IconClass)> navItems = new()
    {
        ("/note", "fa fa-commenting-o"),
        ("/current-tasks", "fa fa-check-square"),
        ("/calendar", "fa fa-calendar"),
        ("/settings", "fa fa-cog")
    };

    private bool IsActive(string url)
        => NavManager.Uri.Contains(url, StringComparison.OrdinalIgnoreCase);
}
