@implements IDisposable
@inject NavigationManager NavManager

<div class="bottom-nav-container">
    <div class="bottom-nav-bar">
        @foreach (var item in navItems)
        {
            <button class="nav-btn @(IsActive(item.Url) ? "active" : "")"
                    @onclick="() => NavManager.NavigateTo(item.Url)">
                <i class="@item.IconClass"></i>
            </button>
        }
    </div>
</div>

@code {
    private List<(string Url, string IconClass)> navItems = new()
{
    ("/note", "fa-solid fa-pen-to-square"),         // Notițe: ✏️
    ("/current-tasks", "fa-solid fa-list-check"),   // Taskuri curente: 📝✅
    ("/calendar", "fa-solid fa-calendar-days"),     // Calendar: 📅
    ("/settings", "fa-solid fa-gear")               // Setări: ⚙️
};


    private bool IsActive(string url)
        => NavManager.Uri.Contains(url, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged(); 
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
