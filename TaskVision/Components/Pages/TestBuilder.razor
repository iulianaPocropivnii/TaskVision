@page "/builder-demo"
@using TaskVision.Models.Tasks.Builder
@using TaskVision.Services.Interfaces
@inject IServiceProvider ServiceProvider

<h3>Test Builder Pattern</h3>

<input class="form-control mb-2" placeholder="Titlu" @bind="title" />
<input class="form-control mb-2" placeholder="Descriere" @bind="description" />
<input class="form-control mb-2" type="date" @bind="deadline" />

<button class="btn btn-success" @onclick="AddTask">Adaugă Task</button>

<ul class="mt-3">
    @foreach (var t in tasks)
    {
        <li>
            <b>@t.Title</b> - @t.Description
            @if (t is TaskVision.Models.Tasks.DeadlineTask dt)
            {
                <span>(Deadline: @dt.Deadline.ToShortDateString())</span>
            }
        </li>
    }
</ul>

@code {
    private string title;
    private string description;
    private DateTime? deadline; // schimbat din string

    private List<ITask> tasks = new();

    private void AddTask()
    {
        var builder = new TaskBuilder()
            .WithTitle(title)
            .WithDescription(description)
            .WithDatabaseService(GetDbService());

        if (deadline.HasValue)
            builder.WithDeadline(deadline.Value); // trimitem direct DateTime

        var task = builder.Build();
        tasks.Add(task);

        // resetăm formularul
        title = description = string.Empty;
        deadline = null;
    }

    private IDatabaseService GetDbService()
    {
        return (IDatabaseService)ServiceProvider.GetService(typeof(IDatabaseService));
    }
}
