@page "/calendar"
@inject NavigationManager Navigation

<h3 class="text-center mb-4">Calendar Evenimente</h3>

<div class="calendar-container">
    @for (var week = 0; week < 6; week++)
    {
        <div class="calendar-row">
            @for (var day = 0; day < 7; day++)
            {
                var current = calendarStart.AddDays(week * 7 + day);
                var hasEvent = events.Any(e => e.Date.Date == current.Date);
                var classes = "calendar-cell";

                if (current.Month != selectedMonth.Month)
                    classes += " other-month";

                if (current.Date == selectedDate.Date)
                    classes += " selected";

                if (hasEvent)
                    classes += " has-event";

                <div class="@classes" @onclick="() => SelectDate(current)">
                    <span>@current.Day</span>
                </div>
            }
        </div>
    }
</div>

<div class="mt-4">
    <h5>Evenimente pentru: @selectedDate.ToShortDateString()</h5>
    <ul>
        @foreach (var ev in events.Where(e => e.Date.Date == selectedDate.Date))
        {
            <li>@ev.Title</li>
        }
    </ul>

    <input type="text" placeholder="Titlu eveniment" @bind="eventTitle" class="form-control mt-2" />
    <button class="btn btn-success mt-1" @onclick="AddEvent">Adaugă Eveniment</button>
</div>

@code {
    private DateTime selectedDate = DateTime.Today;
    private DateTime selectedMonth = DateTime.Today;
    private DateTime calendarStart => selectedMonth.AddDays(-(int)selectedMonth.DayOfWeek);

    private string eventTitle;
    private List<CalendarEvent> events = new();

    private void SelectDate(DateTime date)
    {
        selectedDate = date;
    }

    private void AddEvent()
    {
        if (!string.IsNullOrWhiteSpace(eventTitle))
        {
            events.Add(new CalendarEvent { Date = selectedDate, Title = eventTitle });
            eventTitle = string.Empty;
        }
    }

    public class CalendarEvent
    {
        public DateTime Date { get; set; }
        public string Title { get; set; }
    }
}
