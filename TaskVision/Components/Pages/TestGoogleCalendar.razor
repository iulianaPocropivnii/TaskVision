@page "/testcalendar"
@inject TaskVision.Services.Interfaces.IGoogleCalendarAdapter GoogleAdapter
@using TaskVision.Models.Calendar

<h3>Test Calendar Google</h3>

<button class="btn btn-primary" @onclick="LoadEvents">Încarcă Evenimente</button>

@if (events != null)
{
    <ul>
        @foreach (var e in events)
        {
            <li>
                <strong>@e.Date.ToString("dd/MM/yyyy HH:mm")</strong> - @e.Title
            </li>
        }
    </ul>
}
else if (error != null)
{
    <p style="color:red">@error</p>
}

@code {
    private List<CalendarEvent> events;
    private string error;

    private async Task LoadEvents()
    {
        try
        {
            events = await GoogleAdapter.GetEventsAsync(DateTime.Now, DateTime.Now.AddDays(7));
        }
        catch (Exception ex)
        {
            error = "Eroare: " + ex.Message;
        }
    }
}
